//==========================================================================
//  BASKET AGGREGATION — RefreshBaskets
//==========================================================================
void AddPositionToBasket(BasketState &basket)
{
   string comment  = PositionGetString(POSITION_COMMENT);
   int    posType  = (int)PositionGetInteger(POSITION_TYPE);
   int    dir      = (posType == POSITION_TYPE_BUY ? DIR_BUY : DIR_SELL);
   double volume   = PositionGetDouble(POSITION_VOLUME);
   double priceOp  = PositionGetDouble(POSITION_PRICE_OPEN);
   datetime opTime = (datetime)PositionGetInteger(POSITION_TIME);
   double profit   = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   int parsedId    = ParseBasketId(comment);

   if(!basket.active)
   {
      basket.active          = true;
      basket.id              = parsedId;
      basket.direction       = dir;
      basket.firstEntryTime  = opTime;
      basket.lastEntryTime   = opTime;
      basket.lastEntryPrice  = priceOp;
      basket.entries         = 0;
      basket.totalLots       = 0.0;
      basket.weightedAvgPrice= 0.0;
      basket.floatingProfit  = 0.0;
   }
   if(basket.id == 0 && parsedId > 0) basket.id = parsedId;
   if(opTime < basket.firstEntryTime || basket.firstEntryTime == 0) basket.firstEntryTime = opTime;
   if(opTime >= basket.lastEntryTime)
   { basket.lastEntryTime = opTime; basket.lastEntryPrice = priceOp; }

   basket.entries++;
   basket.weightedAvgPrice += priceOp * volume;
   basket.totalLots        += volume;
   basket.floatingProfit   += profit;
   basket.direction         = dir;
}

double CurrentBasketExitPrice(int direction)
{
   if(direction == DIR_BUY)  return SymbolInfoDouble(g_symbol, SYMBOL_BID);
   if(direction == DIR_SELL) return SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   return 0.0;
}

void RefreshBaskets()
{
   BasketState collected[MODULE_COUNT];
   for(int i = 0; i < MODULE_COUNT; i++)
   {
      ResetBasket(collected[i]);
      collected[i].moduleTag = g_modules[i].cfg.tag;
   }

   for(int p = PositionsTotal()-1; p >= 0; p--)
   {
      ulong ticket = PositionGetTicket(p);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetString(POSITION_SYMBOL) != g_symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC) != InpMagicNumber) continue;
      string cmt = PositionGetString(POSITION_COMMENT);
      int idx = -1;
      for(int i = 0; i < MODULE_COUNT; i++)
         if(CommentMatchesTag(cmt, g_modules[i].cfg.tag)) { idx = i; break; }
      if(idx < 0) continue;
      AddPositionToBasket(collected[idx]);
   }

   for(int i = 0; i < MODULE_COUNT; i++)
   {
      if(collected[i].active && collected[i].totalLots > 0.0)
      {
         collected[i].weightedAvgPrice /= collected[i].totalLots;
         if(collected[i].id <= 0)
            collected[i].id = (g_modules[i].basket.active && g_modules[i].basket.id > 0)
                               ? g_modules[i].basket.id : g_nextBasketId++;

         double cp = CurrentBasketExitPrice(collected[i].direction);
         double excursion = 0.0;
         if(collected[i].direction == DIR_BUY)
            excursion = (cp - collected[i].weightedAvgPrice) / g_point;
         else if(collected[i].direction == DIR_SELL)
            excursion = (collected[i].weightedAvgPrice - cp) / g_point;

         if(g_modules[i].basket.active && g_modules[i].basket.id == collected[i].id)
         {
            collected[i].mfe = MathMax(g_modules[i].basket.mfe, collected[i].floatingProfit);
            collected[i].mae = MathMin(g_modules[i].basket.mae, collected[i].floatingProfit);
            collected[i].maxExcursionPoints = MathMax(g_modules[i].basket.maxExcursionPoints, MathAbs(excursion));
         }
         else
         {
            collected[i].mfe = MathMax(0.0, collected[i].floatingProfit);
            collected[i].mae = MathMin(0.0, collected[i].floatingProfit);
            collected[i].maxExcursionPoints = MathAbs(excursion);
         }
         g_modules[i].basket = collected[i];
      }
      else
      {
         ResetBasket(g_modules[i].basket);
         g_modules[i].basket.moduleTag = g_modules[i].cfg.tag;
      }
   }
}

