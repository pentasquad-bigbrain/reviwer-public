//==========================================================================
//  EQUITY PROTECTION
//==========================================================================
bool EquityProtectionPauseActive()
{
   return (g_equityProtectionPauseUntil > 0 && TimeCurrent() < g_equityProtectionPauseUntil);
}

bool EquityProtectionAllowsNewBasket(int idx)
{
   if(!EquityProtectionPauseActive()) return true;
   if(!InpAllowEquityProtectionHedge) return false;
   int dir = g_modules[idx].cfg.direction;
   if(dir == DIR_SELL && DirectionalOpenLots(DIR_BUY)  > DirectionalOpenLots(DIR_SELL)) return true;
   if(dir == DIR_BUY  && DirectionalOpenLots(DIR_SELL) > DirectionalOpenLots(DIR_BUY))  return true;
   return false;
}

bool EquityProtectionHedgeBasket(int idx)
{
   return (EquityProtectionPauseActive() && EquityProtectionAllowsNewBasket(idx));
}

void PauseEntriesForEquityProtection(string detail)
{
   int pauseSec = MathMax(1, InpForcedCooldownMinutes) * 60;
   datetime until = TimeCurrent() + pauseSec;
   if(until > g_equityProtectionPauseUntil) g_equityProtectionPauseUntil = until;
   if(TimeCurrent() - g_lastEquityProtectionLog >= 300)
   {
      g_lastEquityProtectionLog = TimeCurrent();
      LogEvent("CORE", StringFormat("equity protection active until %s: %s",
         TimeToString(g_equityProtectionPauseUntil, TIME_DATE|TIME_MINUTES), detail));
   }
}

//==========================================================================
//  EXIT / ESCAPE LOGIC
//==========================================================================
double TargetBufferPoints(const ModuleConfig &cfg, const RegimeSnapshot &r)
{
   return MathMax(cfg.targetPoints, r.atrM1Points * cfg.atrTargetMult);
}

double TargetMoney(const ModuleConfig &cfg, const BasketState &basket)
{
   if(basket.totalLots <= 0.0) return cfg.targetMoneyPer001;
   return cfg.targetMoneyPer001 * (basket.totalLots / 0.01);
}

double BasketFavorablePoints(const BasketState &basket)
{
   double price = CurrentBasketExitPrice(basket.direction);
   if(price <= 0.0 || basket.weightedAvgPrice <= 0.0) return 0.0;
   if(basket.direction == DIR_BUY)  return (price - basket.weightedAvgPrice) / g_point;
   if(basket.direction == DIR_SELL) return (basket.weightedAvgPrice - price) / g_point;
   return 0.0;
}

double BasketAdversePoints(const BasketState &basket)
{
   double fav = BasketFavorablePoints(basket);
   return (fav < 0.0) ? -fav : 0.0;
}

bool FavorableImpulse(int direction, const RegimeSnapshot &r)
{
   if(!r.expansionM1 && r.m1RangePoints < r.atrM1Points * InpFastCloseAtrMultiplier) return false;
   if(direction == DIR_BUY)
      return (r.bullishM1 && r.m1Close > r.m1Low + (r.m1High - r.m1Low) * 0.65);
   if(direction == DIR_SELL)
      return (r.bearishM1 && r.m1Close < r.m1High - (r.m1High - r.m1Low) * 0.65);
   return false;
}

double BasketSafeLossLimit(const BasketState &basket)
{
   double lots = MathMax(0.01, basket.totalLots);
   return MathMax(0.0, InpSafeExitMaxLossPer001) * lots / 0.01;
}

bool SafeToForceCloseBasket(const BasketState &basket, double favorable, string &detail)
{
   detail = "";
   if(!InpUseSafeBasketExit) { detail = "safe exit disabled"; return true; }
   if(basket.floatingProfit >= InpSafeExitMinProfitMoney)
   { detail = StringFormat("safe profit %.2f", basket.floatingProfit); return true; }
   double lossLim = BasketSafeLossLimit(basket);
   if(basket.floatingProfit >= -lossLim && favorable >= -InpSafeExitNearAveragePoints)
   { detail = StringFormat("near-avg controlled exit pl=%.2f fav=%.1f", basket.floatingProfit, favorable); return true; }
   detail = StringFormat("held for recovery pl=%.2f lim=%.2f fav=%.1f", basket.floatingProfit, lossLim, favorable);
   return false;
}

bool DdEscapeTriggered(string &detail)
{
   detail = "";
   if(InpDDMode <= 0 || InpDDValue <= 0.0) return false;
   double bal = AccountInfoDouble(ACCOUNT_BALANCE);
   double eq  = AccountInfoDouble(ACCOUNT_EQUITY);
   double dd  = bal - eq;
   if(dd <= 0.0) return false;
   if(InpDDMode == 1)
   {
      double pct = (bal > 0.0 ? dd / bal * 100.0 : 0.0);
      if(pct >= InpDDValue) { detail = StringFormat("DD %.2f%% >= %.2f%%", pct, InpDDValue); return true; }
   }
   else if(InpDDMode == 2)
   {
      if(dd >= InpDDValue) { detail = StringFormat("DD %.2f >= %.2f", dd, InpDDValue); return true; }
   }
   return false;
}

bool EquityProtectionTriggered(string &detail)
{
   detail = "";
   if(!InpUseEquityProtection) return false;
   double bal = AccountInfoDouble(ACCOUNT_BALANCE);
   double eq  = AccountInfoDouble(ACCOUNT_EQUITY);
   double dd  = bal - eq;
   if(dd <= 0.0) return false;
   if(InpEquityProtectionMoney > 0.0 && dd >= InpEquityProtectionMoney)
   { detail = StringFormat("equity DD %.2f >= %.2f", dd, InpEquityProtectionMoney); return true; }
   if(InpEquityProtectionPercent > 0.0 && bal > 0.0)
   {
      double pct = dd / bal * 100.0;
      if(pct >= InpEquityProtectionPercent)
      { detail = StringFormat("equity DD %.2f%% >= %.2f%%", pct, InpEquityProtectionPercent); return true; }
   }
   return false;
}

//==========================================================================
//  CLOSE BASKET
//==========================================================================
bool ClosePositionTicket(ulong ticket)
{
   if(!PositionSelectByTicket(ticket)) return false;
   bool result = trade.PositionClose(ticket, InpSlippage);
   if(!result)
      PrintFormat("%s [%s] close failed ticket=%I64u ret=%d %s",
                  EA_NAME, g_symbol, ticket, trade.ResultRetcode(), trade.ResultRetcodeDescription());
   return result;
}

int CloseBasket(int idx, ENUM_ZGM_CLOSE_REASON reason, string detail, bool forced)
{
   RefreshBaskets();
   BasketState basket  = g_modules[idx].basket;
   if(!basket.active) return 0;

   double preProfit    = basket.floatingProfit;
   int    preEntries   = basket.entries;
   datetime now        = TimeCurrent();
   long holdSeconds    = (long)(now - basket.firstEntryTime);
   int  closed         = 0;
   string tag          = g_modules[idx].cfg.tag;
   int    ri           = (int)reason;
   if(ri < 0 || ri >= CR_COUNT) ri = 0;

   for(int p = PositionsTotal()-1; p >= 0; p--)
   {
      ulong ticket = PositionGetTicket(p);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetString(POSITION_SYMBOL) != g_symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC) != InpMagicNumber) continue;
      if(!CommentMatchesTag(PositionGetString(POSITION_COMMENT), tag)) continue;
      if(ClosePositionTicket(ticket)) closed++;
   }

   if(closed == 0)
   {
      // Market closed or connectivity issue — debounce 60 s to avoid log spam on every timer tick
      g_modules[idx].retryCloseAfter = TimeCurrent() + 60;
      return 0;
   }

   if(closed > 0)
   {
      LogEvent(tag, StringFormat("basket close reason=%s id=%d entries=%d floating=%.2f detail=%s",
         g_reasonNames[ri], basket.id, basket.entries, basket.floatingProfit, detail));
      CsvLog("basket_close_start", tag, basket.id, detail, preProfit, basket.totalLots);
      g_modules[idx].stats.basketCount++;
      g_modules[idx].stats.tradeCount    += closed;
      g_modules[idx].stats.entrySum      += preEntries;
      g_modules[idx].stats.holdSecondsSum+= holdSeconds;
      g_modules[idx].stats.profitSum     += preProfit;
      g_modules[idx].stats.mfeSum        += basket.mfe;
      g_modules[idx].stats.maeSum        += basket.mae;
      g_modules[idx].stats.maxExcursionSum += basket.maxExcursionPoints;
      if(preProfit >= 0.0) g_modules[idx].stats.winCount++;
      else                 g_modules[idx].stats.lossCount++;

      g_modules[idx].retryCloseAfter = 0;   // close succeeded — clear debounce
      g_reasonCounts[ri]++;
      int coolSec = (forced ? InpForcedCooldownMinutes : g_modules[idx].cfg.cooldownMinutes) * 60;
      g_modules[idx].cooldownUntil = now + coolSec;

      LogCloseLine(tag, closed);
      CsvLog("basket_closed", tag, basket.id, g_reasonNames[ri], preProfit, AccountInfoDouble(ACCOUNT_BALANCE));
   }
   RefreshBaskets();
   return closed;
}

void CloseAllBaskets(ENUM_ZGM_CLOSE_REASON reason, string detail, bool forced)
{
   for(int i = 0; i < MODULE_COUNT; i++)
      if(g_modules[i].basket.active) CloseBasket(i, reason, detail, forced);
}

//==========================================================================
//  RISK MANAGEMENT & EXITS
//==========================================================================
void ManageRiskAndExits()
{
   RefreshBaskets();

   string ddDetail = "";
   if(DdEscapeTriggered(ddDetail)) { CloseAllBaskets(CR_DD_MODE, ddDetail, true); return; }

   double globalFL = TotalFloatingProfit();
   if(InpMaxGlobalFloatingLossMoney > 0.0 && globalFL <= -InpMaxGlobalFloatingLossMoney)
   {
      CloseAllBaskets(CR_GLOBAL_LOSS,
         StringFormat("global floating %.2f <= -%.2f", globalFL, InpMaxGlobalFloatingLossMoney), true);
      return;
   }

   string eqDetail = "";
   if(EquityProtectionTriggered(eqDetail))
   {
      if(InpEquityProtectionCloseBaskets) { CloseAllBaskets(CR_EQUITY_PROTECTION, eqDetail, true); return; }
      PauseEntriesForEquityProtection(eqDetail);
   }

   for(int i = 0; i < MODULE_COUNT; i++)
   {
      BasketState basket = g_modules[i].basket;
      if(!basket.active) continue;
      if(TimeCurrent() < g_modules[i].retryCloseAfter) continue;  // debounce failed close
      ModuleConfig cfg   = g_modules[i].cfg;
      double favorable   = BasketFavorablePoints(basket);
      double adverse     = BasketAdversePoints(basket);
      double buffer      = TargetBufferPoints(cfg, g_regime);
      double moneyTgt    = TargetMoney(cfg, basket);
      long   ageMins     = (long)((TimeCurrent() - basket.firstEntryTime) / 60);

      if(cfg.maxLossMoney > 0.0 && basket.floatingProfit <= -cfg.maxLossMoney)
      {
         CloseBasket(i, CR_BASKET_LOSS,
            StringFormat("basket pl %.2f <= -%.2f", basket.floatingProfit, cfg.maxLossMoney), true);
         continue;
      }
      if(cfg.maxAdversePoints > 0.0 && adverse >= cfg.maxAdversePoints)
      {
         string sd = "";
         if(SafeToForceCloseBasket(basket, favorable, sd))
         { CloseBasket(i, CR_ADVERSE_POINTS, StringFormat("adverse %.1f pts >= %.1f; %s", adverse, cfg.maxAdversePoints, sd), true); continue; }
      }
      if(cfg.maxAgeMinutes > 0 && ageMins >= cfg.maxAgeMinutes)
      {
         string sd = "";
         if(SafeToForceCloseBasket(basket, favorable, sd))
         { CloseBasket(i, CR_SAFE_RECOVERY, StringFormat("age %d min >= %d; %s", (int)ageMins, cfg.maxAgeMinutes, sd), false); continue; }
      }
      if(ShouldSessionFlatten(cfg, TimeCurrent()))
      {
         string sd = "";
         if(SafeToForceCloseBasket(basket, favorable, sd))
         { CloseBasket(i, CR_SESSION_END, StringFormat("session-end flatten; %s", sd), false); continue; }
      }
      if(basket.floatingProfit >= moneyTgt)
      { CloseBasket(i, CR_MONEY_TARGET, StringFormat("profit %.2f >= target %.2f", basket.floatingProfit, moneyTgt), false); continue; }
      if(favorable >= buffer)
      {
         string sd = "";
         if(SafeToForceCloseBasket(basket, favorable, sd))
         { CloseBasket(i, CR_PRICE_BUFFER, StringFormat("favorable %.1f >= buffer %.1f; %s", favorable, buffer, sd), false); continue; }
      }
      if(basket.floatingProfit >= InpFastCloseMinProfitMoney && FavorableImpulse(basket.direction, g_regime))
      { CloseBasket(i, CR_FAST_IMPULSE, StringFormat("favorable impulse pl=%.2f", basket.floatingProfit), false); continue; }
   }
}

//==========================================================================
//  ENTRY ENGINE
//==========================================================================
bool TradeStops(int direction, double &sl, double &tp)
{
   sl = 0.0; tp = 0.0;
   if(!InpUseSafetyStops) return true;
   double ask = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   if(direction == DIR_BUY)
   {
      if(InpSafetySLPoints > 0.0) sl = NormalizeDouble(ask - InpSafetySLPoints * g_point, g_digits);
      if(InpSafetyTPPoints > 0.0) tp = NormalizeDouble(ask + InpSafetyTPPoints * g_point, g_digits);
   }
   else if(direction == DIR_SELL)
   {
      if(InpSafetySLPoints > 0.0) sl = NormalizeDouble(bid + InpSafetySLPoints * g_point, g_digits);
      if(InpSafetyTPPoints > 0.0) tp = NormalizeDouble(bid - InpSafetyTPPoints * g_point, g_digits);
   }
   return true;
}

bool ExecuteEntry(int idx, int basketId, string entryKind, string reason)
{
   ModuleConfig cfg = g_modules[idx].cfg;
   double lot = CalculateLot();
   double sl = 0.0, tp = 0.0;
   TradeStops(cfg.direction, sl, tp);
   string cmt = OrderComment(cfg.tag, basketId);

   bool ok = false;
   if(cfg.direction == DIR_BUY)  ok = trade.Buy(lot,  g_symbol, 0.0, sl, tp, cmt);
   else if(cfg.direction == DIR_SELL) ok = trade.Sell(lot, g_symbol, 0.0, sl, tp, cmt);

   if(ok)
   {
      g_modules[idx].lastEntryBar     = g_regime.m1BarTime;
      g_modules[idx].lastSignalReason = reason;
      LogEvent(cfg.tag, StringFormat("%s %s lot=%.2f basket=%d reason=%s",
         entryKind, DirectionName(cfg.direction), lot, basketId, reason));
      CsvLog(entryKind, cfg.tag, basketId, reason, lot, SpreadPoints());
      return true;
   }
   PrintFormat("%s [%s] [%s] entry failed kind=%s ret=%d %s",
      EA_NAME, g_symbol, cfg.tag, entryKind, trade.ResultRetcode(), trade.ResultRetcodeDescription());
   return false;
}

bool CanOpenNewBasket(int idx)
{
   bool hedge = EquityProtectionHedgeBasket(idx);
   if(EquityProtectionPauseActive() && !hedge) return false;
   if(OpenBasketCount() >= InpMaxGlobalBaskets &&
      !(hedge && InpEquityProtectionHedgeBypassMaxBaskets)) return false;
   if(TimeCurrent() < g_modules[idx].cooldownUntil) return false;
   if(g_modules[idx].lastEntryBar == g_regime.m1BarTime) return false;
   if(InpBlockFridayNightEntry && !hedge)
   {
      MqlDateTime dt; TimeToStruct(TimeCurrent(), dt);
      if(dt.day_of_week == 5 && dt.hour >= 22) return false;  // Friday 22:00+: no new baskets before weekend
   }
   return true;
}

bool ShouldLayer(int idx, SignalInfo &sig, string &layerReason)
{
   layerReason = "";
   BasketState basket = g_modules[idx].basket;
   ModuleConfig cfg   = g_modules[idx].cfg;
   if(!basket.active) return false;
   bool hedgeLayer = (EquityProtectionPauseActive() && InpAllowEquityProtectionHedge &&
      ((basket.direction == DIR_SELL && DirectionalOpenLots(DIR_BUY)  > DirectionalOpenLots(DIR_SELL)) ||
       (basket.direction == DIR_BUY  && DirectionalOpenLots(DIR_SELL) > DirectionalOpenLots(DIR_BUY))));
   if(EquityProtectionPauseActive() && !hedgeLayer) return false;
   if(basket.entries >= cfg.maxEntries) return false;
   if(g_modules[idx].lastEntryBar == g_regime.m1BarTime) return false;
   if(TimeCurrent() - basket.lastEntryTime < cfg.minLayerSeconds) return false;
   if(InpLayerOnlyInsideSession && !IsSessionActive(cfg, TimeCurrent())) return false;
   if(!SpreadAllowed(idx)) return false;

   double spacing = MathMax(cfg.minLayerPoints, g_regime.atrM1Points * cfg.layerAtrMult);
   double bid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(g_symbol, SYMBOL_ASK);

   if(basket.direction == DIR_BUY)
   {
      double adverse = (basket.lastEntryPrice - ask) / g_point;
      if(adverse >= spacing)
      { layerReason = StringFormat("adverse recovery %.1f >= spacing %.1f", adverse, spacing); return true; }
      if(InpAllowContinuationLayer && sig.valid && basket.entries < cfg.maxEntries)
      {
         double favMove = (bid - basket.lastEntryPrice) / g_point;
         if(favMove >= spacing * InpContinuationLayerFraction &&
            g_regime.lowerWickPoints > g_regime.m1BodyPoints * 0.60)
         { layerReason = StringFormat("buy continuation %.1f", favMove); return true; }
      }
   }
   else if(basket.direction == DIR_SELL)
   {
      double adverse = (bid - basket.lastEntryPrice) / g_point;
      if(adverse >= spacing)
      { layerReason = StringFormat("adverse sell recovery %.1f >= spacing %.1f", adverse, spacing); return true; }
      if(InpAllowContinuationLayer && sig.valid && basket.entries < cfg.maxEntries)
      {
         double favMove = (basket.lastEntryPrice - ask) / g_point;
         if(favMove >= spacing * InpContinuationLayerFraction &&
            g_regime.upperWickPoints > g_regime.m1BodyPoints * 0.60)
         { layerReason = StringFormat("sell continuation %.1f", favMove); return true; }
      }
   }
   return false;
}

void ProcessEntryEngine()
{
   if(g_paused) return;   // EA paused via panel button
   SignalInfo signals[MODULE_COUNT];
   int    bestIdx   = -1;
   double bestScore = -1.0;

   for(int i = 0; i < MODULE_COUNT; i++)
   {
      BuildSignal(i, g_regime, signals[i]);
      if(signals[i].score > bestScore) { bestScore = signals[i].score; bestIdx = i; }
   }

   string newActive = (bestIdx >= 0 && bestScore > 0.0) ? g_modules[bestIdx].cfg.tag : "None";
   if(newActive != g_activeModule)
   {
      g_activeModule = newActive;
      if(bestIdx >= 0 && bestScore > 0.0)
         LogEvent(g_modules[bestIdx].cfg.tag,
            StringFormat("active module chosen score=%.2f reason=%s", bestScore, signals[bestIdx].reason));
   }

   int openedThisBar = 0;
   for(int i = 0; i < MODULE_COUNT; i++)
   {
      if(openedThisBar >= InpMaxNewEntriesPerBar) break;
      if(g_modules[i].basket.active)
      {
         string lr = "";
         if(ShouldLayer(i, signals[i], lr))
            if(ExecuteEntry(i, g_modules[i].basket.id, "additional layered entry", lr)) openedThisBar++;
      }
      else
      {
         bool isHedge = EquityProtectionHedgeBasket(i);
         // Allow hedge entry even when signals[i].valid=false (outside session / below score).
         // The hedge direction comes from cfg.direction; signal validity is irrelevant for emergency hedges.
         if((signals[i].valid || isHedge) && CanOpenNewBasket(i))
         {
            int bid2 = g_nextBasketId++;
            string eKind  = "first basket entry";
            string eReason= signals[i].reason;
            if(isHedge && EquityProtectionPauseActive())
            {
               eKind   = "equity protection hedge entry";
               eReason = (StringLen(eReason) > 0 ? eReason + "; " : "")
                       + StringFormat("EP emergency hedge dir=%s", DirectionName(g_modules[i].cfg.direction));
            }
            if(ExecuteEntry(i, bid2, eKind, eReason)) openedThisBar++;
         }
      }
   }
   if(openedThisBar > 0) RefreshBaskets();
}

//==========================================================================
//  TODAY CLOSED PROFIT
//==========================================================================
double TodayClosedProfit()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   dt.hour = 0; dt.min = 0; dt.sec = 0;
   datetime dayStart = StructToTime(dt);
   if(!HistorySelect(dayStart, TimeCurrent())) return 0.0;
   double profit = 0.0;
   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != g_symbol) continue;
      if((long)HistoryDealGetInteger(ticket, DEAL_MAGIC) != InpMagicNumber) continue;
      long entry = HistoryDealGetInteger(ticket, DEAL_ENTRY);
      if(entry != DEAL_ENTRY_OUT && entry != DEAL_ENTRY_OUT_BY) continue;
      profit += HistoryDealGetDouble(ticket, DEAL_PROFIT);
      profit += HistoryDealGetDouble(ticket, DEAL_SWAP);
      profit += HistoryDealGetDouble(ticket, DEAL_COMMISSION);
   }
   return profit;
}

string CurrentSessionName()
{
   datetime now = TimeCurrent();
   string names = "";
   for(int i = 0; i < MODULE_COUNT; i++)
      if(IsSessionActive(g_modules[i].cfg, now))
      {
         if(StringLen(names) > 0) names += ",";
         names += g_modules[i].cfg.tag;
      }
   return (StringLen(names) == 0) ? "Off" : names;
}

