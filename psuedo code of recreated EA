string UpperAscii(string value)
{
   string text = value;
   int len = StringLen(text);
   for(int i = 0; i < len; i++)
   {
      ushort ch = StringGetCharacter(text, i);
      if(ch >= 'a' && ch <= 'z')
         StringSetCharacter(text, i, (ushort)(ch - 32));
   }
   return text;
}

bool ContainsGoldName(string symbolName)
{
   string s = UpperAscii(symbolName);
   if(StringFind(s, "GOLD") >= 0) return true;
   if(StringFind(s, "XAU")  >= 0) return true;
   return false;
}

string ResolveTradeSymbol()
{
   string requested = InpTradeSymbol;
   if(StringLen(requested) <= 0) requested = _Symbol;
   if(SymbolSelect(requested, true)) return requested;
   if(InpAllowSymbolSearch)
   {
      int total = SymbolsTotal(false);
      for(int i = 0; i < total; i++)
      {
         string candidate = SymbolName(i, false);
         if(ContainsGoldName(candidate) && SymbolSelect(candidate, true))
            return candidate;
      }
   }
   return requested;
}

