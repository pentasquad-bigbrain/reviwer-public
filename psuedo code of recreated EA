//  JSON DATA EXPORT  (writes MQL5/Files/zentry_live.json every bar)
//==========================================================================
void WriteJsonData()
{
   if(!InpUseCsvLog) return;
   int h = FileOpen("zentry_live.json", FILE_WRITE|FILE_TXT|FILE_COMMON|FILE_ANSI);
   if(h == INVALID_HANDLE) return;

   double bal = AccountInfoDouble(ACCOUNT_BALANCE);
   double eq  = AccountInfoDouble(ACCOUNT_EQUITY);
   double flt = TotalFloatingProfit();
   double tod = TodayClosedProfit();
   double dd  = (bal>0.0) ? MathMax(0.0,(bal-eq)/bal*100.0) : 0.0;
   string ts  = TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS);
   StringReplace(ts," ","T");

   FileWriteString(h,"{\n");
   FileWriteString(h, StringFormat("  \"ea\":\"%s\",\n",          EA_NAME));
   FileWriteString(h, StringFormat("  \"symbol\":\"%s\",\n",      g_symbol));
   FileWriteString(h, StringFormat("  \"time\":\"%s\",\n",        ts));
   FileWriteString(h, StringFormat("  \"balance\":%.2f,\n",       bal));
   FileWriteString(h, StringFormat("  \"equity\":%.2f,\n",        eq));
   FileWriteString(h, StringFormat("  \"floating\":%.2f,\n",      flt));
   FileWriteString(h, StringFormat("  \"todayPnl\":%.2f,\n",      tod));
   FileWriteString(h, StringFormat("  \"drawdown\":%.2f,\n",      dd));
   FileWriteString(h, StringFormat("  \"startBalance\":%.2f,\n",  g_startBalance));
   FileWriteString(h, StringFormat("  \"spread\":%.0f,\n",        SpreadPoints()));
   FileWriteString(h, StringFormat("  \"atrM1\":%.0f,\n",         g_regime.atrM1Points));
   FileWriteString(h, StringFormat("  \"slopeM5\":%.1f,\n",       g_regime.slopeM5Points));
   FileWriteString(h, StringFormat("  \"slopeM15\":%.1f,\n",      g_regime.slopeM15Points));
   FileWriteString(h, StringFormat("  \"compress\":%s,\n",        g_regime.compressionM1?"true":"false"));
   FileWriteString(h, StringFormat("  \"expand\":%s,\n",          g_regime.expansionM1  ?"true":"false"));
   FileWriteString(h, StringFormat("  \"paused\":%s,\n",          g_paused              ?"true":"false"));
   FileWriteString(h, StringFormat("  \"openBaskets\":%d,\n",     OpenBasketCount()));
   FileWriteString(h, StringFormat("  \"totalLots\":%.2f,\n",     TotalOpenLots()));
   // Zones array
   FileWriteString(h,"  \"zones\":[\n");
   for(int i=0; i<MODULE_COUNT; i++)
   {
      double sc=0.0;
      string why = WhyNoTrade(i,sc);
      BasketState b = g_modules[i].basket;
      bool sOn = IsSessionActive(g_modules[i].cfg, TimeCurrent());
      int  age = b.active ? (int)((TimeCurrent()-b.firstEntryTime)/60) : 0;
      FileWriteString(h, StringFormat(
         "    {\"tag\":\"%s\",\"session\":%s,\"open\":%s,\"positions\":%d,"
         "\"lots\":%.2f,\"dir\":\"%s\",\"floating\":%.2f,\"avgPrice\":%.2f,"
         "\"score\":%.2f,\"scoreMin\":%.2f,\"why\":\"%s\",\"ageMins\":%d}%s\n",
         g_modules[i].cfg.tag,
         sOn?"true":"false", b.active?"true":"false",
         b.entries, b.totalLots,
         (g_modules[i].cfg.direction==DIR_BUY?"BUY":"SELL"),
         b.floatingProfit, b.weightedAvgPrice,
         sc, g_modules[i].cfg.scoreMin, why, age,
         (i<MODULE_COUNT-1)?",":""));
   }
   FileWriteString(h,"  ],\n");
   // Close reason stats
   FileWriteString(h,"  \"closeReasons\":{\n");
   for(int r=0; r<CR_COUNT; r++)
      FileWriteString(h, StringFormat("    \"%s\":%d%s\n",
         g_reasonNames[r], g_reasonCounts[r], (r<CR_COUNT-1)?",":""));
   FileWriteString(h,"  },\n");
   // Last 25 closed deals
   FileWriteString(h,"  \"trades\":[\n");
   HistorySelect(0, TimeCurrent());
   int dTotal=HistoryDealsTotal(), written=0, maxT=25;
   for(int d=dTotal-1; d>=0 && written<maxT; d--)
   {
      ulong tk=HistoryDealGetTicket(d);
      if(HistoryDealGetInteger(tk,DEAL_MAGIC)!=InpMagicNumber) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(tk,DEAL_ENTRY)!=DEAL_ENTRY_OUT) continue;
      double dp=HistoryDealGetDouble(tk,DEAL_PROFIT)+HistoryDealGetDouble(tk,DEAL_COMMISSION)+HistoryDealGetDouble(tk,DEAL_SWAP);
      string dt2=TimeToString((datetime)HistoryDealGetInteger(tk,DEAL_TIME),TIME_DATE|TIME_SECONDS);
      StringReplace(dt2," ","T");
      string cmt=HistoryDealGetString(tk,DEAL_COMMENT);
      FileWriteString(h, StringFormat(
         "    {\"time\":\"%s\",\"profit\":%.2f,\"lots\":%.2f,\"comment\":\"%s\"}%s\n",
         dt2, dp, HistoryDealGetDouble(tk,DEAL_VOLUME), cmt,
         (written<maxT-1 && d>0)?",":""));
      written++;
   }
   FileWriteString(h,"  ]\n}\n");
   FileClose(h);
}

//==========================================================================
//  CHART EVENT HANDLER — Panel Button Clicks
//==========================================================================
void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK) return;

   if(sparam == ZGM_PFX+"BTN_PAUSE")
   {
      g_paused = !g_paused;
      LogEvent("PANEL", StringFormat("EA %s via panel", g_paused?"PAUSED":"RESUMED"));
      UpdatePanel();
      ObjectSetInteger(0, ZGM_PFX+"BTN_PAUSE", OBJPROP_STATE, false);
      return;
   }
   if(sparam == ZGM_PFX+"BTN_CLOSE")
   {
      LogEvent("PANEL", "Close All — requested via panel button");
      CloseAllBaskets(CR_SESSION_END, "panel close-all", true);
      ObjectSetInteger(0, ZGM_PFX+"BTN_CLOSE", OBJPROP_STATE, false);
      return;
   }
   if(sparam == ZGM_PFX+"BTN_DASH")
   {
      WriteJsonData();
      // Write open-flag so the Python server opens the browser
      int fh = FileOpen("zentry_open_dash.flag", FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON);
      if(fh!=INVALID_HANDLE) { FileWriteString(fh,"1"); FileClose(fh); }
      LogEvent("PANEL", "Dashboard: run zentry_server.py then visit http://localhost:8765");
      ObjectSetInteger(0, ZGM_PFX+"BTN_DASH", OBJPROP_STATE, false);
      return;
   }
   if(sparam == ZGM_PFX+"BTN_CLOUD")
   {
      WriteJsonData();
      int fh = FileOpen("zentry_open_cloud.flag", FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON);
      if(fh!=INVALID_HANDLE) { FileWriteString(fh,"1"); FileClose(fh); }
      LogEvent("PANEL", "Cloudflare push requested — run zentry_server.py with CF_WORKER_URL set");
      ObjectSetInteger(0, ZGM_PFX+"BTN_CLOUD", OBJPROP_STATE, false);
      return;
   }
}

//==========================================================================
//  INDICATOR INIT
//==========================================================================
//  INDICATOR INIT / RELEASE
//==========================================================================
bool InitializeIndicators()
{
   g_atrM1     = iATR(g_symbol, PERIOD_M1,  InpAtrPeriod);
   g_atrM5     = iATR(g_symbol, PERIOD_M5,  InpAtrPeriod);
   g_atrM15    = iATR(g_symbol, PERIOD_M15, InpAtrPeriod);
   g_emaFastM5 = iMA(g_symbol, PERIOD_M5,  InpFastEmaPeriod, 0, MODE_EMA, PRICE_CLOSE);
   g_emaSlowM5 = iMA(g_symbol, PERIOD_M5,  InpSlowEmaPeriod, 0, MODE_EMA, PRICE_CLOSE);
   g_emaFastM15= iMA(g_symbol, PERIOD_M15, InpFastEmaPeriod, 0, MODE_EMA, PRICE_CLOSE);
   g_emaSlowM15= iMA(g_symbol, PERIOD_M15, InpSlowEmaPeriod, 0, MODE_EMA, PRICE_CLOSE);
   g_emaTrendH1= iMA(g_symbol, PERIOD_H1,  InpTrendEmaPeriod,0, MODE_EMA, PRICE_CLOSE);
   if(g_atrM1 == INVALID_HANDLE || g_atrM5 == INVALID_HANDLE || g_atrM15 == INVALID_HANDLE ||
      g_emaFastM5 == INVALID_HANDLE || g_emaSlowM5 == INVALID_HANDLE ||
      g_emaFastM15 == INVALID_HANDLE || g_emaSlowM15 == INVALID_HANDLE || g_emaTrendH1 == INVALID_HANDLE)
   { PrintFormat("%s [%s] indicator init failed", EA_NAME, g_symbol); return false; }
   return true;
}

void ReleaseIndicators()
{
   if(g_atrM1    != INVALID_HANDLE) IndicatorRelease(g_atrM1);
   if(g_atrM5    != INVALID_HANDLE) IndicatorRelease(g_atrM5);
   if(g_atrM15   != INVALID_HANDLE) IndicatorRelease(g_atrM15);
   if(g_emaFastM5!= INVALID_HANDLE) IndicatorRelease(g_emaFastM5);
   if(g_emaSlowM5!= INVALID_HANDLE) IndicatorRelease(g_emaSlowM5);
   if(g_emaFastM15!=INVALID_HANDLE) IndicatorRelease(g_emaFastM15);
   if(g_emaSlowM15!=INVALID_HANDLE) IndicatorRelease(g_emaSlowM15);
   if(g_emaTrendH1!=INVALID_HANDLE) IndicatorRelease(g_emaTrendH1);
}

void InitCsv()
{
   if(!InpUseCsvLog) return;
   int flags = FILE_CSV|FILE_READ|FILE_WRITE|FILE_SHARE_WRITE|FILE_ANSI;
   if(InpUseCommonCsv) flags |= FILE_COMMON;
   g_csvHandle = FileOpen(InpCsvFileName, flags, ',');
   if(g_csvHandle == INVALID_HANDLE) { PrintFormat("%s CSV open failed: %s", EA_NAME, InpCsvFileName); return; }
   if(FileSize(g_csvHandle) == 0)
      FileWrite(g_csvHandle, "time","symbol","module","basket_id","event","value1","value2","detail");
   FileSeek(g_csvHandle, 0, SEEK_END);
}

//==========================================================================
//  SUMMARY
//==========================================================================
void PrintSummary(string context)
{
   PrintFormat("%s [%s] %s summary. Start balance %.2f, balance %.2f, equity %.2f",
      EA_NAME, g_symbol, context, g_startBalance,
      AccountInfoDouble(ACCOUNT_BALANCE), AccountInfoDouble(ACCOUNT_EQUITY));
   for(int i = 0; i < MODULE_COUNT; i++)
   {
      ModuleStats s  = g_modules[i].stats;
      double avgEnt  = (s.basketCount > 0 ? (double)s.entrySum / s.basketCount : 0.0);
      double winRate = (s.basketCount > 0 ? (double)s.winCount / s.basketCount * 100.0 : 0.0);
      double avgHold = (s.basketCount > 0 ? (double)s.holdSecondsSum / s.basketCount / 60.0 : 0.0);
      double avgMfe  = (s.basketCount > 0 ? s.mfeSum / s.basketCount : 0.0);
      double avgMae  = (s.basketCount > 0 ? s.maeSum / s.basketCount : 0.0);
      double avgExc  = (s.basketCount > 0 ? s.maxExcursionSum / s.basketCount : 0.0);
      PrintFormat("%s [%s] module %s baskets=%d trades=%d avg_entries=%.2f win_rate=%.1f%% avg_hold=%.1fmin profit=%.2f avg_mfe=%.2f avg_mae=%.2f avg_excursion=%.1f",
         EA_NAME, g_symbol, g_modules[i].cfg.tag,
         s.basketCount, s.tradeCount, avgEnt, winRate, avgHold,
         s.profitSum, avgMfe, avgMae, avgExc);
   }
   string reasons = "";
   for(int r = 0; r < CR_COUNT; r++)
   {
      if(g_reasonCounts[r] <= 0) continue;
      if(StringLen(reasons) > 0) reasons += ", ";
      reasons += StringFormat("%s=%d", g_reasonNames[r], g_reasonCounts[r]);
   }
   if(StringLen(reasons) == 0) reasons = "none";
   PrintFormat("%s [%s] closure reasons: %s", EA_NAME, g_symbol, reasons);
}

//==========================================================================
//  ONINIT / ONDEINIT / ONTICK / ONTIMER / ONTESTER
//==========================================================================
int OnInit()
{
   SetReasonNames();
   ArrayInitialize(g_reasonCounts, 0);

   g_symbol = ResolveTradeSymbol();
   if(!SymbolSelect(g_symbol, true))
   { PrintFormat("%s symbol select failed: %s", EA_NAME, g_symbol); return INIT_FAILED; }

   if(InpStrictGoldOnly && !ContainsGoldName(g_symbol))
   { PrintFormat("%s non-gold symbol blocked: %s", EA_NAME, g_symbol); return INIT_PARAMETERS_INCORRECT; }

   g_point  = SymbolInfoDouble(g_symbol, SYMBOL_POINT);
   g_digits = (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS);
   if(g_point <= 0.0) { PrintFormat("%s invalid point for %s", EA_NAME, g_symbol); return INIT_FAILED; }

   ConfigureModules();
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(InpSlippage);
   trade.SetTypeFillingBySymbol(g_symbol);

   long marginMode = AccountInfoInteger(ACCOUNT_MARGIN_MODE);
   if(marginMode != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
      PrintFormat("%s [%s] WARNING: account is not hedging mode — baskets work best on hedging accounts", EA_NAME, g_symbol);

   if(!InitializeIndicators()) return INIT_FAILED;

   ArrayResize(g_ratesM1,  64);
   ArrayResize(g_ratesM5,  64);
   ArrayResize(g_ratesM15, 64);
   ArrayResize(g_ratesH1,  16);

   InitCsv();
   g_startTime    = TimeCurrent();
   g_startBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   EventSetTimer(MathMax(1, InpTimerSeconds));
   RefreshBaskets();

   PrintFormat("%s [%s] initialized. %s", EA_NAME, g_symbol, InpNoteOverview);
   CsvLog("init", "CORE", 0, InpNoteName, g_startBalance, AccountInfoDouble(ACCOUNT_EQUITY));
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   PrintSummary("OnDeinit");
   CsvLog("deinit", "CORE", 0, StringFormat("reason=%d", reason),
          AccountInfoDouble(ACCOUNT_BALANCE), AccountInfoDouble(ACCOUNT_EQUITY));
   if(g_csvHandle != INVALID_HANDLE) { FileClose(g_csvHandle); g_csvHandle = INVALID_HANDLE; }
   EventKillTimer();
   DeletePanel();
   ReleaseIndicators();
}

void EnginePulse()
{
   if(!UpdateRegime()) { UpdatePanel(); return; }
   RefreshBaskets();
   ManageRiskAndExits();
   UpdatePanel();
   datetime curM1 = iTime(g_symbol, PERIOD_M1, 0);
   if(curM1 <= 0) return;
   if(curM1 != g_lastM1Bar) { g_lastM1Bar = curM1; ProcessEntryEngine(); }
   WriteJsonData();
}

void OnTick()  { EnginePulse(); }
void OnTimer() { EnginePulse(); }

double OnTester()
{
   PrintSummary("OnTester");
   return TesterStatistics(STAT_PROFIT);
}
