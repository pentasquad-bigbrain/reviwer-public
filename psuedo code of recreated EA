//  SPREAD
//==========================================================================
double SpreadPoints()
{
   double bid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   if(g_point <= 0.0 || bid <= 0.0 || ask <= 0.0) return 0.0;
   return (ask - bid) / g_point;
}

bool SpreadAllowed(int idx)
{
   double spread = SpreadPoints();
   if(spread <= InpSpread) return true;
   datetime now = TimeCurrent();
   if(now - g_modules[idx].lastSpreadLog >= 60)
   {
      g_modules[idx].lastSpreadLog = now;
      PrintFormat("%s [%s] [%s] spread %.0f > max %d",
                  EA_NAME, g_symbol, g_modules[idx].cfg.tag, spread, InpSpread);
   }
   return false;
}

//==========================================================================
//  INDICATOR COPY HELPERS
//==========================================================================
bool CopyOne(int handle, int shift, double &value)
{
   if(handle == INVALID_HANDLE) return false;
   double buf[1];
   if(CopyBuffer(handle, 0, shift, 1, buf) != 1) return false;
   value = buf[0];
   return true;
}

bool CopyTwo(int handle, int shift, double &current, double &previous)
{
   if(handle == INVALID_HANDLE) return false;
   double buf[2];
   if(CopyBuffer(handle, 0, shift, 2, buf) != 2) return false;
   current  = buf[0];
   previous = buf[1];
   return true;
}

double RecentRangePoints(MqlRates &rates[], int startIndex, int count)
{
   int total = ArraySize(rates);
   if(total <= startIndex) return 0.0;
   double hi = -DBL_MAX, lo = DBL_MAX;
   int limit = MathMin(total, startIndex + count);
   for(int i = startIndex; i < limit; i++)
   {
      hi = MathMax(hi, rates[i].high);
      lo = MathMin(lo, rates[i].low);
   }
   if(hi <= -DBL_MAX/2.0 || lo >= DBL_MAX/2.0 || g_point <= 0.0) return 0.0;
   return (hi - lo) / g_point;
}

//==========================================================================
//  REGIME SNAPSHOT
//==========================================================================
bool UpdateRegime()
{
   ArraySetAsSeries(g_ratesM1,  true);
   ArraySetAsSeries(g_ratesM5,  true);
   ArraySetAsSeries(g_ratesM15, true);
   ArraySetAsSeries(g_ratesH1,  true);

   if(CopyRates(g_symbol, PERIOD_M1,  0, 64, g_ratesM1)  < 32) return false;
   if(CopyRates(g_symbol, PERIOD_M5,  0, 64, g_ratesM5)  < 32) return false;
   if(CopyRates(g_symbol, PERIOD_M15, 0, 64, g_ratesM15) < 32) return false;
   if(CopyRates(g_symbol, PERIOD_H1,  0, 16, g_ratesH1)  < 8)  return false;

   double atrM1 = 0, atrM5 = 0, atrM15 = 0;
   double efM5 = 0, efM5p = 0, esM5 = 0;
   double efM15 = 0, efM15p = 0, esM15 = 0, etH1 = 0;

   if(!CopyOne(g_atrM1,     1, atrM1))   return false;
   if(!CopyOne(g_atrM5,     1, atrM5))   return false;
   if(!CopyOne(g_atrM15,    1, atrM15))  return false;
   if(!CopyTwo(g_emaFastM5, 1, efM5, efM5p))   return false;
   if(!CopyOne(g_emaSlowM5, 1, esM5))   return false;
   if(!CopyTwo(g_emaFastM15,1, efM15, efM15p))  return false;
   if(!CopyOne(g_emaSlowM15,1, esM15))  return false;
   if(!CopyOne(g_emaTrendH1,1, etH1))   return false;

   MqlRates c = g_ratesM1[1];
   double body  = MathAbs(c.close - c.open);
   double upper = c.high - MathMax(c.close, c.open);
   double lower = MathMin(c.close, c.open) - c.low;
   double range = c.high - c.low;

   g_regime.ready          = true;
   g_regime.m1BarTime      = g_ratesM1[0].time;
   g_regime.atrM1          = atrM1;
   g_regime.atrM5          = atrM5;
   g_regime.atrM15         = atrM15;
   g_regime.atrM1Points    = atrM1 / g_point;
   g_regime.atrM5Points    = atrM5 / g_point;
   g_regime.atrM15Points   = atrM15 / g_point;
   g_regime.emaFastM5      = efM5;
   g_regime.emaFastM5Prev  = efM5p;
   g_regime.emaSlowM5      = esM5;
   g_regime.emaFastM15     = efM15;
   g_regime.emaFastM15Prev = efM15p;
   g_regime.emaSlowM15     = esM15;
   g_regime.emaTrendH1     = etH1;
   g_regime.m1Open         = c.open;
   g_regime.m1High         = c.high;
   g_regime.m1Low          = c.low;
   g_regime.m1Close        = c.close;
   g_regime.m1BodyPoints   = body  / g_point;
   g_regime.m1RangePoints  = range / g_point;
   g_regime.upperWickPoints= upper / g_point;
   g_regime.lowerWickPoints= lower / g_point;
   g_regime.range6M1Points = RecentRangePoints(g_ratesM1, 1, 6);
   g_regime.range20M1Points= RecentRangePoints(g_ratesM1, 1, 20);
   g_regime.slopeM5Points  = (efM5 - efM5p)   / g_point;
   g_regime.slopeM15Points = (efM15 - efM15p)  / g_point;
   g_regime.bullishM1      = (c.close > c.open);
   g_regime.bearishM1      = (c.close < c.open);
   g_regime.compressionM1  = (g_regime.atrM1Points > 0.0 &&
                               g_regime.range6M1Points < g_regime.atrM1Points * InpCompressionAtrFactor);
   g_regime.expansionM1    = (g_regime.atrM1Points > 0.0 &&
                               g_regime.m1RangePoints > g_regime.atrM1Points * InpExpansionAtrFactor);
   return true;
}

bool AtrAllowed(const RegimeSnapshot &r)
{
   if(!r.ready) return false;
   if(r.atrM1Points < InpMinAtrM1Points) return false;
   if(r.atrM1Points > InpMaxAtrM1Points) return false;
   return true;
}

//==========================================================================
//  SIGNAL ENGINE
//==========================================================================
void AddReason(string &reason, string text)
{
   if(StringLen(reason) > 0) reason += "; ";
   reason += text;
}

void ClearSignal(SignalInfo &sig)
{
   sig.valid     = false;
   sig.direction = DIR_NONE;
   sig.score     = 0.0;
   sig.reason    = "";
}

bool T5Cadence(datetime when)
{
   if(InpT5CadenceMinutes <= 0) return true;
   MqlDateTime dt;
   TimeToStruct(when, dt);
   int mod = dt.min % InpT5CadenceMinutes;
   return (mod <= InpT5CadenceToleranceMinutes ||
           mod >= InpT5CadenceMinutes - InpT5CadenceToleranceMinutes);
}

void BuildSignal(int idx, const RegimeSnapshot &r, SignalInfo &sig)
{
   ClearSignal(sig);
   ModuleConfig cfg = g_modules[idx].cfg;
   datetime now = TimeCurrent();
   MqlDateTime dt;
   TimeToStruct(now, dt);

   if(!cfg.enabled) return;
   if(IsXmasBlocked(now)) return;
   if(!IsTradingWeekday(dt.day_of_week)) return;
   if(!IsSessionActive(cfg, now)) return;
   if(!AtrAllowed(r)) return;
   if(!SpreadAllowed(idx)) return;
   if(now < g_modules[idx].cooldownUntil) return;

   double score  = 1.0 + WeekdayBonus(dt.day_of_week);
   string reason = "session";

   if(idx == 0) // ZA/W01 — late session BUY micro mean-reversion
   {
      if(r.lowerWickPoints > MathMax(8.0, r.m1BodyPoints * InpWickBodyFactor))
      { score += 1.15; AddReason(reason, "lower wick rejection"); }
      if((r.emaFastM5 - r.m1Close) / g_point > r.atrM1Points * InpPullbackAtrFactor)
      { score += 1.10; AddReason(reason, "late pullback below M5 EMA"); }
      if(r.compressionM1)
      { score += 0.85; AddReason(reason, "M1 range compression"); }
      if(r.slopeM5Points > -InpMaxBearSlopeForBuyPoints)
      { score += 0.75; AddReason(reason, "M5 slope stable"); }
      if(r.bullishM1 && r.m1Close > (r.m1Low + (r.m1High - r.m1Low) * 0.55))
      { score += 0.75; AddReason(reason, "micro recovery close"); }
      if(dt.hour == 23 || dt.hour == 1)
         score += 0.40;
   }
   else if(idx == 1) // ZB/W03 — late US BUY hybrid
   {
      if(r.slopeM5Points > -40.0)
      { score += 0.85; AddReason(reason, "hybrid M5 slope"); }
      if(r.bullishM1 && r.expansionM1)
      { score += 1.05; AddReason(reason, "bullish expansion"); }
      if((r.emaFastM5 - r.m1Close) / g_point > r.atrM1Points * 0.10 &&
         r.lowerWickPoints > r.m1BodyPoints * 0.70)
      { score += 1.10; AddReason(reason, "pullback rejection"); }
      if(r.m1Close > r.emaSlowM5 || r.slopeM15Points > -80.0)
      { score += 0.80; AddReason(reason, "late US constructive regime"); }
      if(r.compressionM1) score += 0.45;
   }
   else if(idx == 2) // ZC/W04 — early NY BUY impulse/pullback
   {
      if(r.slopeM5Points > 0.0)
      { score += 1.05; AddReason(reason, "early NY positive M5 slope"); }
      if(r.m1Close > r.emaFastM5)
      { score += 0.85; AddReason(reason, "close above M5 EMA"); }
      if(r.bullishM1 && (r.expansionM1 || r.lowerWickPoints > r.m1BodyPoints * 0.60))
      { score += 1.10; AddReason(reason, "impulse pullback buy"); }
      if(r.slopeM15Points > -70.0)
      { score += 0.65; AddReason(reason, "M15 not hostile"); }
   }
   else if(idx == 3) // ZD/W09 — late morning BUY cadence scalp
   {
      if(InpT5ThuFriBiasOnly && !(dt.day_of_week == 4 || dt.day_of_week == 5))
         return;
      if(T5Cadence(now))
      { score += 0.95; AddReason(reason, "late morning cadence"); }
      if(r.compressionM1 || r.range20M1Points < r.atrM1Points * 4.5)
      { score += 0.85; AddReason(reason, "opportunistic compression"); }
      if(r.bullishM1 || r.lowerWickPoints > r.m1BodyPoints * 0.80)
      { score += 0.90; AddReason(reason, "short-hold buy structure"); }
      if(MathAbs(r.slopeM5Points) < 140.0 || r.slopeM5Points > 0.0)
      { score += 0.60; AddReason(reason, "moderate late morning regime"); }
   }
   else if(idx == 4) // ZE/W12 — London morning SELL reversal
   {
      if((dt.day_of_week == 3 || dt.day_of_week == 5) && InpT6WeakDayPenalty > 0.0)
      { score -= InpT6WeakDayPenalty; AddReason(reason, "T6 weak-day filter"); }
      if(r.upperWickPoints > MathMax(8.0, r.m1BodyPoints * InpWickBodyFactor))
      { score += 1.15; AddReason(reason, "upper wick exhaustion"); }
      if((r.m1Close - r.emaFastM5) / g_point > r.atrM1Points * InpPullbackAtrFactor)
      { score += 1.00; AddReason(reason, "price stretched above M5 EMA"); }
      if(r.slopeM5Points < InpMaxBullSlopeForSellPoints)
      { score += 0.80; AddReason(reason, "London slope sellable"); }
      if(r.bearishM1 && (r.expansionM1 ||
         r.m1Close < (r.m1High - (r.m1High - r.m1Low) * 0.55)))
      { score += 1.05; AddReason(reason, "bearish reversal candle"); }
      if(r.slopeM15Points < 120.0) score += 0.45;
   }

   sig.score     = score;
   sig.direction = cfg.direction;
   sig.reason    = reason;
   sig.valid     = (score >= cfg.scoreMin);
}

//==========================================================================
//  LOT SIZING
//==========================================================================
double NormalizeVolume(double volume)
{
   double minVol  = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MIN);
   double maxVol  = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MAX);
   double step    = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_STEP);
   if(step <= 0.0) step = 0.01;
   double normalized = MathFloor(volume / step + 0.0000001) * step;
   normalized = MathMax(minVol, MathMin(maxVol, normalized));
   return NormalizeDouble(normalized, 2);
}

double CalculateLot()
{
   double lot = InpLotsFixed;
   if(InpLotsCalc == 0) // balance-step (primary)
   {
      double balance   = AccountInfoDouble(ACCOUNT_BALANCE);
      double blockBal  = MathMax(1.0, InpLotsFixedBalance);
      int    blocks    = (int)MathFloor(balance / blockBal);
      if(blocks < 1) blocks = 1;
      if(InpAutoLotsValue > 0) blocks = MathMin(blocks, InpAutoLotsValue);
      lot = InpLotsFixed * blocks;
   }
   else if(InpLotsCalc == 2)
   {
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      double blocks  = MathMax(1.0, balance / MathMax(1.0, InpLotsFixedBalance));
      lot = InpLotsFixed * MathMin(blocks, MathMax(1, InpAutoLotsValue));
   }
   return NormalizeVolume(lot);
}

