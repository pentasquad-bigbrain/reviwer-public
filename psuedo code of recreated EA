// ── Coordinate helpers (panel-local → MT5 CORNER_RIGHT_UPPER) ─────────────────
// With CORNER_RIGHT_UPPER: XDISTANCE is measured from the right edge.
// For an element at local x (0=panel-left, PNL_W=panel-right):
//   XDISTANCE = PNL_XR + (PNL_W - local_x)
int PX(int lx) { return PNL_XR + (PNL_W - lx); }
int PY(int ly) { return PNL_YT + ly; }

// ── Object creation helpers ───────────────────────────────────────────────────
void MkRect(string id, int lx, int ly, int w, int h, color bg, color brd)
{
   string nm = ZGM_PFX + id;
   if(ObjectFind(0,nm) < 0) ObjectCreate(0,nm,OBJ_RECTANGLE_LABEL,0,0,0);
   ObjectSetInteger(0,nm,OBJPROP_CORNER,     CORNER_RIGHT_UPPER);
   ObjectSetInteger(0,nm,OBJPROP_XDISTANCE,  PX(lx+w));
   ObjectSetInteger(0,nm,OBJPROP_YDISTANCE,  PY(ly));
   ObjectSetInteger(0,nm,OBJPROP_XSIZE,      w);
   ObjectSetInteger(0,nm,OBJPROP_YSIZE,      h);
   ObjectSetInteger(0,nm,OBJPROP_BGCOLOR,    bg);
   ObjectSetInteger(0,nm,OBJPROP_COLOR,      brd);
   ObjectSetInteger(0,nm,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,nm,OBJPROP_BACK,       false);
   ObjectSetInteger(0,nm,OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0,nm,OBJPROP_HIDDEN,     true);
   ObjectSetInteger(0,nm,OBJPROP_ZORDER,     0);
}

void MkLbl(string id, int lx, int ly, string txt, color clr, int sz=8, bool bld=false)
{
   string nm = ZGM_PFX + id;
   if(ObjectFind(0,nm) < 0)
   {
      ObjectCreate(0,nm,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,nm,OBJPROP_CORNER,    CORNER_RIGHT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_ANCHOR,    ANCHOR_LEFT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,nm,OBJPROP_HIDDEN,    true);
      ObjectSetInteger(0,nm,OBJPROP_ZORDER,    2);
   }
   ObjectSetInteger(0,nm,OBJPROP_XDISTANCE, PX(lx + (int)StringLen(txt)*sz));
   ObjectSetInteger(0,nm,OBJPROP_YDISTANCE, PY(ly));
   ObjectSetInteger(0,nm,OBJPROP_COLOR,     clr);
   ObjectSetString(0, nm,OBJPROP_FONT,      bld ? "Arial Bold" : InpFont);
   ObjectSetInteger(0,nm,OBJPROP_FONTSIZE,  sz);
   ObjectSetString(0, nm,OBJPROP_TEXT,      txt);
}

void MkLblFixed(string id, int lx, int ly, string txt, color clr, int sz=8, bool bld=false)
{
   // Version with fixed xdistance (not text-length-based)
   string nm = ZGM_PFX + id;
   if(ObjectFind(0,nm) < 0)
   {
      ObjectCreate(0,nm,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,nm,OBJPROP_CORNER,    CORNER_RIGHT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_ANCHOR,    ANCHOR_LEFT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,nm,OBJPROP_HIDDEN,    true);
      ObjectSetInteger(0,nm,OBJPROP_ZORDER,    2);
   }
   ObjectSetInteger(0,nm,OBJPROP_XDISTANCE, PX(lx + PNL_W - 4));
   ObjectSetInteger(0,nm,OBJPROP_YDISTANCE, PY(ly));
   ObjectSetInteger(0,nm,OBJPROP_COLOR,     clr);
   ObjectSetString(0, nm,OBJPROP_FONT,      bld ? "Arial Bold" : InpFont);
   ObjectSetInteger(0,nm,OBJPROP_FONTSIZE,  sz);
   ObjectSetString(0, nm,OBJPROP_TEXT,      txt);
}

void L(string id, int lx, int ly, string txt, color clr, int sz=8, bool b=false)
{
   // Simplified label: lx is distance from panel LEFT (position from right = PNL_XR + PNL_W - lx)
   string nm = ZGM_PFX + id;
   if(ObjectFind(0,nm) < 0)
   {
      ObjectCreate(0,nm,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,nm,OBJPROP_CORNER,    CORNER_RIGHT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_ANCHOR,    ANCHOR_LEFT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,nm,OBJPROP_HIDDEN,    true);
      ObjectSetInteger(0,nm,OBJPROP_ZORDER,    2);
   }
   ObjectSetInteger(0,nm,OBJPROP_XDISTANCE, PNL_XR + PNL_W - lx);
   ObjectSetInteger(0,nm,OBJPROP_YDISTANCE, PY(ly));
   ObjectSetInteger(0,nm,OBJPROP_COLOR,     clr);
   ObjectSetString(0, nm,OBJPROP_FONT,      b ? "Arial Bold" : InpFont);
   ObjectSetInteger(0,nm,OBJPROP_FONTSIZE,  sz);
   ObjectSetString(0, nm,OBJPROP_TEXT,      txt);
}

void MkBtn(string id, int lx, int ly, int w, int h, string txt, color bg, color tc)
{
   string nm = ZGM_PFX + id;
   if(ObjectFind(0,nm) < 0)
   {
      ObjectCreate(0,nm,OBJ_BUTTON,0,0,0);
      ObjectSetInteger(0,nm,OBJPROP_CORNER,    CORNER_RIGHT_UPPER);
      ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,nm,OBJPROP_HIDDEN,    false);
      ObjectSetInteger(0,nm,OBJPROP_ZORDER,    3);
   }
   ObjectSetInteger(0,nm,OBJPROP_XDISTANCE, PNL_XR + PNL_W - lx - w);
   ObjectSetInteger(0,nm,OBJPROP_YDISTANCE, PY(ly));
   ObjectSetInteger(0,nm,OBJPROP_XSIZE,     w);
   ObjectSetInteger(0,nm,OBJPROP_YSIZE,     h);
   ObjectSetInteger(0,nm,OBJPROP_BGCOLOR,   bg);
   ObjectSetInteger(0,nm,OBJPROP_COLOR,     tc);
   ObjectSetString(0, nm,OBJPROP_FONT,      "Arial Bold");
   ObjectSetInteger(0,nm,OBJPROP_FONTSIZE,  7);
   ObjectSetString(0, nm,OBJPROP_TEXT,      txt);
   ObjectSetInteger(0,nm,OBJPROP_STATE,     false);
}

void DeletePanel()
{
   for(int i=ObjectsTotal(0,0,-1)-1; i>=0; i--)
   {
      string nm = ObjectName(0,i,0,-1);
      if(StringFind(nm,ZGM_PFX)==0 || StringFind(nm,"ZGM_LINE_")==0)
         ObjectDelete(0,nm);
   }
}

//==========================================================================
//  WHY NO TRADE — Diagnostic Engine
//==========================================================================
string WhyNoTrade(int idx, double &outScore)
{
   outScore = 0.0;
   if(!g_regime.ready) return "regime not ready";
   ModuleConfig cfg = g_modules[idx].cfg;
   if(!cfg.enabled)    return "zone disabled";
   datetime now = TimeCurrent();
   MqlDateTime dt; TimeToStruct(now, dt);
   if(IsXmasBlocked(now))          return "holiday block";
   if(!IsTradingWeekday(dt.day_of_week)) return "weekend";
   if(g_paused)                    return "EA paused";
   if(EquityProtectionPauseActive()) return "equity protect";
   if(!IsSessionActive(cfg, now))  return "no active session";
   if(g_modules[idx].basket.active) { outScore = 0.0; return ""; } // basket open = normal
   if(InpBlockFridayNightEntry && dt.day_of_week==5 && dt.hour>=22) return "Fri night block";
   if(OpenBasketCount() >= InpMaxGlobalBaskets) return StringFormat("max baskets(%d)", InpMaxGlobalBaskets);
   double sp = SpreadPoints();
   if(sp > (double)InpSpread) return StringFormat("spread %.0f>%d", sp, InpSpread);
   if(!AtrAllowed(g_regime))
   {
      if(g_regime.atrM1Points < InpMinAtrM1Points)
         return StringFormat("ATR low(%.0f<%.0f)", g_regime.atrM1Points, InpMinAtrM1Points);
      return StringFormat("ATR high(%.0f>%.0f)", g_regime.atrM1Points, InpMaxAtrM1Points);
   }
   if(TimeCurrent() < g_modules[idx].cooldownUntil)
   {
      int s = (int)(g_modules[idx].cooldownUntil - TimeCurrent());
      return StringFormat("cooldown %dm%ds", s/60, s%60);
   }
   SignalInfo sig; BuildSignal(idx, g_regime, sig);
   outScore = sig.score;
   if(sig.valid) return "ready to trade";
   // Break down what's missing
   string miss = "";
   double gap = cfg.scoreMin - sig.score;
   if(gap > 0.0) miss = StringFormat("score %.2f<%.2f (gap %.2f)", sig.score, cfg.scoreMin, gap);
   return miss;
}

