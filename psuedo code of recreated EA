//==========================================================================
//  TIME UTILITIES
//==========================================================================
bool IsTradingWeekday(int dow)
{
   if(dow == 1) return InpTradeMonday;
   if(dow == 2) return InpTradeTuesday;
   if(dow == 3) return InpTradeWednesday;
   if(dow == 4) return InpTradeThursday;
   if(dow == 5) return InpTradeFriday;
   return false;
}

double WeekdayBonus(int dow)
{
   if(dow == 2) return InpTuesdayScoreBonus;
   if(dow == 4) return InpThursdayScoreBonus;
   if(dow == 5) return InpFridayScoreBonus;
   return 0.0;
}

int MinuteOfDay(datetime when)
{
   MqlDateTime dt;
   TimeToStruct(when, dt);
   return dt.hour * 60 + dt.min;
}

int WindowMinute(int hour, int minute)
{
   return MathMax(0, MathMin(23, hour)) * 60 + MathMax(0, MathMin(59, minute));
}

bool MinuteInWindow(int currentMinute, int startMinute, int endMinute)
{
   if(startMinute <= endMinute)
      return (currentMinute >= startMinute && currentMinute <= endMinute);
   return (currentMinute >= startMinute || currentMinute <= endMinute);
}

bool IsSessionActive(const ModuleConfig &cfg, datetime when)
{
   int cur = MinuteOfDay(when);
   int s1  = WindowMinute(cfg.start1Hour, cfg.start1Minute);
   int e1  = WindowMinute(cfg.end1Hour,   cfg.end1Minute);
   if(MinuteInWindow(cur, s1, e1)) return true;
   if(cfg.hasSecondSession)
   {
      int s2 = WindowMinute(cfg.start2Hour, cfg.start2Minute);
      int e2 = WindowMinute(cfg.end2Hour,   cfg.end2Minute);
      if(MinuteInWindow(cur, s2, e2)) return true;
   }
   return false;
}

int MinutesAfterEnd(int currentMinute, int endMinute)
{
   int diff = currentMinute - endMinute;
   if(diff < 0) diff += 1440;
   return diff;
}

bool ShouldSessionFlatten(const ModuleConfig &cfg, datetime when)
{
   if(!InpSessionEndFlatten) return false;
   if(IsSessionActive(cfg, when)) return false;
   int cur  = MinuteOfDay(when);
   int e1   = WindowMinute(cfg.end1Hour, cfg.end1Minute);
   int aft1 = MinutesAfterEnd(cur, e1);
   if(aft1 > 0 && aft1 <= cfg.flattenMinutes) return true;
   if(cfg.hasSecondSession)
   {
      int e2   = WindowMinute(cfg.end2Hour, cfg.end2Minute);
      int aft2 = MinutesAfterEnd(cur, e2);
      if(aft2 > 0 && aft2 <= cfg.flattenMinutes) return true;
   }
   return false;
}

bool IsXmasBlocked(datetime when)
{
   if(InpXmas <= 0) return false;
   MqlDateTime dt;
   TimeToStruct(when, dt);
   return (dt.mon == 12 && dt.day >= 24 && dt.day <= 26);
}

string DirectionName(int direction)
{
   if(direction == DIR_BUY)  return "buy";
   if(direction == DIR_SELL) return "sell";
   return "none";
}

