void DrawPanelBg()
{
   // Outer panel
   MkRect("BG",      0, 0, PNL_W, PNL_H, C_BG,   C_SEP);
   // Header
   MkRect("H_BG",    0, 0, PNL_W, RH_HDR, C_HDR,  C_ACC);
   // Accent left stripe
   MkRect("H_STR",   0, 0, 3,     RH_HDR, C_ACC,  C_ACC);
   // Account row
   MkRect("A_BG",    0, RH_HDR, PNL_W, RH_ACC, C_CARD, C_SEP);
   // Account sub-cards (4 columns)
   int cw = (PNL_W - 10) / 4;
   for(int c=0; c<4; c++)
      MkRect(StringFormat("A_C%d",c), 2+c*(cw+2), RH_HDR+2, cw, RH_ACC-4, C_BG, C_SEP);
   // Zone section
   int zy = RH_HDR + RH_ACC + RH_SEP;
   MkRect("ZH_BG",   0, zy, PNL_W, RH_ZHDR, C_DRK,  C_SEP);
   for(int z=0; z<MODULE_COUNT; z++)
      MkRect(StringFormat("ZR%d",z), 0, zy+RH_ZHDR+z*RH_ZON, PNL_W, RH_ZON,
             (z%2==0)?C_CARD:C_BG, C_SEP);
   // Market row
   int my = zy + RH_ZHDR + MODULE_COUNT*RH_ZON + RH_SEP;
   MkRect("M_BG",    0, my, PNL_W, RH_MKT, C_DRK, C_SEP);
   // Stats row
   MkRect("S_BG",    0, my+RH_MKT, PNL_W, RH_STT, C_CARD2, C_SEP);
   // Button row
   int by = my + RH_MKT + RH_STT + RH_SEP;
   MkRect("BTN_BG",  0, by, PNL_W, RH_BTN+RH_PAD, C_HDR, C_ACC);
   MkRect("BTN_STR", 0, by, 3, RH_BTN+RH_PAD, C_PRP, C_PRP);
}

void DrawHeader()
{
   string liveStr = g_paused ? "⏸ PAUSED" : "● LIVE";
   color  liveClr = g_paused ? C_ORG : C_GRN;
   L("H_LIVE",  380, 10, liveStr, liveClr, 7, true);
   L("H_NAME",  296, 10, "ZENTRY GOLD MATRIX  |  " + g_symbol, C_GOLD, 8, true);
   string ts = TimeToString(TimeCurrent(), TIME_MINUTES|TIME_SECONDS);
   L("H_TIME",  70,  10, ts, C_GRY, 7);
}

void DrawAccount()
{
   double bal = AccountInfoDouble(ACCOUNT_BALANCE);
   double eq  = AccountInfoDouble(ACCOUNT_EQUITY);
   double flt = TotalFloatingProfit();
   double tod = TodayClosedProfit();
   double dd  = (bal > 0.0) ? MathMax(0.0,(bal-eq)/bal*100.0) : 0.0;
   int cw = (PNL_W - 10) / 4;
   int ay = RH_HDR;

   // Card 0 — Balance
   L("A_L0", 2+0*(cw+2)+5, ay+5,  "BALANCE",            C_GRY, 7);
   L("A_V0", 2+0*(cw+2)+5, ay+17, StringFormat("$%.2f",bal), C_WHT, 8, true);
   // Card 1 — Equity
   L("A_L1", 2+1*(cw+2)+5, ay+5,  "EQUITY",             C_GRY, 7);
   color eqClr = (eq >= bal) ? C_GRN : C_RED;
   L("A_V1", 2+1*(cw+2)+5, ay+17, StringFormat("$%.2f",eq), eqClr, 8, true);
   // Card 2 — Floating
   L("A_L2", 2+2*(cw+2)+5, ay+5,  "FLOAT P/L",          C_GRY, 7);
   color fClr = (flt>=0.0)?C_GRN:C_RED;
   L("A_V2", 2+2*(cw+2)+5, ay+17, StringFormat("%+.2f",flt), fClr, 8, true);
   // Card 3 — Drawdown + Today
   L("A_L3", 2+3*(cw+2)+5, ay+5,  "DD%  TODAY",         C_GRY, 7);
   color dClr = (dd<5.0)?C_GRN:(dd<15.0?C_ORG:C_RED);
   L("A_V3", 2+3*(cw+2)+5, ay+17, StringFormat("%.1f%%  %+.2f",dd,tod), dClr, 8, true);
   // Spread + ATR sub-info
   double sp2 = SpreadPoints();
   color sClr = (sp2 <= InpSpread) ? C_GRN : C_RED;
   L("A_SP", 2+3*(cw+2)+5, ay+36, StringFormat("SPR:%.0f  ATR:%.0f", sp2, g_regime.atrM1Points), sClr, 7);
}

void DrawZoneTable()
{
   int zy  = RH_HDR + RH_ACC + RH_SEP;
   // Column headers
   L("ZH_ZN", 6,   zy+5, "ZONE",    C_GRY, 7, true);
   L("ZH_ST", 78,  zy+5, "STATUS",  C_GRY, 7, true);
   L("ZH_SC", 150, zy+5, "SCORE",   C_GRY, 7, true);
   L("ZH_PO", 196, zy+5, "POS",     C_GRY, 7, true);
   L("ZH_FL", 236, zy+5, "FLOAT",   C_GRY, 7, true);
   L("ZH_WH", 282, zy+5, "WHY / REASON", C_GRY, 7, true);

   for(int i=0; i<MODULE_COUNT; i++)
   {
      int ry = zy + RH_ZHDR + i*RH_ZON + 4;
      double sc = 0.0;
      string why = WhyNoTrade(i, sc);
      BasketState b   = g_modules[i].basket;
      bool sOn        = IsSessionActive(g_modules[i].cfg, TimeCurrent());
      bool wouldTrade = (why == "ready to trade");

      // Status dot + color
      color stClr;
      string stTxt;
      if(b.active)     { stClr=C_BLU;  stTxt=StringFormat("OPEN(%d)", b.entries); }
      else if(!sOn)    { stClr=C_DIM;  stTxt="OFF"; }
      else if(wouldTrade){ stClr=C_GRN; stTxt="READY"; }
      else             { stClr=C_ORG;  stTxt="WAIT"; }

      // Zone tag
      L(StringFormat("ZN%d_T",i), 6,   ry, g_modules[i].cfg.tag, C_WHT, 7, true);
      // Status
      string dot = b.active ? "●" : (sOn ? "○" : "─");
      L(StringFormat("ZN%d_D",i), 78,  ry, dot,   stClr, 9);
      L(StringFormat("ZN%d_S",i), 93,  ry, stTxt, stClr, 7);
      // Score
      string scStr;
      color  scClr;
      if(sc > 0.0) { scStr=StringFormat("%.2f",sc); scClr=(sc>=g_modules[i].cfg.scoreMin)?C_GRN:C_ORG; }
      else         { scStr="—"; scClr=C_DIM; }
      L(StringFormat("ZN%d_SC",i),150, ry, scStr, scClr, 7);
      // Positions
      string poStr = b.active ? StringFormat("%d×%s %.2fL", b.entries,
                     (g_modules[i].cfg.direction==DIR_BUY?"↑":"↓"), b.totalLots) : "—";
      L(StringFormat("ZN%d_P",i), 196, ry, poStr, b.active?C_BLU:C_DIM, 7);
      // Float
      string flStr = b.active ? StringFormat("%+.2f",b.floatingProfit) : "—";
      color  flClr = b.active ? (b.floatingProfit>=0.0?C_GRN:C_RED) : C_DIM;
      L(StringFormat("ZN%d_F",i), 236, ry, flStr, flClr, 7);
      // Why / age
      string whStr;
      color  whClr;
      if(b.active)
      {
         int ageMins = (int)((TimeCurrent()-b.firstEntryTime)/60);
         whStr = StringFormat("age %dm  avg %.2f", ageMins, b.weightedAvgPrice);
         whClr = C_GRY;
      }
      else { whStr=(StringLen(why)>0?why:"—"); whClr=(wouldTrade?C_GRN:C_ORG); }
      L(StringFormat("ZN%d_W",i), 282, ry, whStr, whClr, 7);
   }
}

void DrawMarketRow()
{
   int my = RH_HDR + RH_ACC + RH_SEP + RH_ZHDR + MODULE_COUNT*RH_ZON + RH_SEP;
   int ry = my + 4;
   string s5d  = (g_regime.slopeM5Points  > 5.0) ? "▲" : (g_regime.slopeM5Points  < -5.0 ? "▼" : "─");
   string s15d = (g_regime.slopeM15Points > 5.0) ? "▲" : (g_regime.slopeM15Points < -5.0 ? "▼" : "─");
   color  s5c  = (g_regime.slopeM5Points  > 5.0) ? C_GRN : (g_regime.slopeM5Points  < -5.0 ? C_RED : C_GRY);
   color  s15c = (g_regime.slopeM15Points > 5.0) ? C_GRN : (g_regime.slopeM15Points < -5.0 ? C_RED : C_GRY);
   string regime = g_regime.compressionM1 ? "COMPRESS" : (g_regime.expansionM1 ? "EXPAND" : "NEUTRAL");
   color  rClr   = g_regime.compressionM1 ? C_ORG : (g_regime.expansionM1 ? C_BLU : C_GRY);
   L("MK_ATR",   6,   ry, StringFormat("ATR:%.0fpt",  g_regime.atrM1Points), C_GRY, 7);
   L("MK_M5",    96,  ry, StringFormat("M5:%s%.0f",   s5d,  MathAbs(g_regime.slopeM5Points)),  s5c,  7);
   L("MK_M15",   182, ry, StringFormat("M15:%s%.0f",  s15d, MathAbs(g_regime.slopeM15Points)), s15c, 7);
   L("MK_RGM",   270, ry, regime, rClr, 7, true);
}

void DrawStatsRow()
{
   int sy = RH_HDR + RH_ACC + RH_SEP + RH_ZHDR + MODULE_COUNT*RH_ZON + RH_SEP + RH_MKT;
   int ry = sy + 4;
   // Count closed deals
   HistorySelect(0, TimeCurrent());
   int  trades=0; double won=0, totPnl=0, grossWin=0, grossLoss=0;
   for(int d=0; d<HistoryDealsTotal(); d++)
   {
      ulong tk = HistoryDealGetTicket(d);
      if(HistoryDealGetInteger(tk,DEAL_MAGIC)!=InpMagicNumber) continue;
      if(HistoryDealGetString(tk,DEAL_SYMBOL)!=g_symbol) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(tk,DEAL_ENTRY)!=DEAL_ENTRY_OUT) continue;
      double dp = HistoryDealGetDouble(tk,DEAL_PROFIT)+HistoryDealGetDouble(tk,DEAL_COMMISSION)+HistoryDealGetDouble(tk,DEAL_SWAP);
      trades++; totPnl += dp;
      if(dp >= 0.0) { won++; grossWin  += dp; }
      else            grossLoss += MathAbs(dp);
   }
   double wr = (trades>0) ? won/trades*100.0 : 0.0;
   double pf = (grossLoss>0.0) ? grossWin/grossLoss : (grossWin>0?9.9:0.0);
   double netPnl = AccountInfoDouble(ACCOUNT_BALANCE) - g_startBalance;
   L("ST_TR",  6,   ry, StringFormat("TRADES:%d",  trades), C_GRY, 7);
   L("ST_WR",  96,  ry, StringFormat("WIN:%.0f%%", wr),     wr>=70?C_GRN:(wr>=50?C_ORG:C_RED), 7);
   L("ST_PF",  182, ry, StringFormat("PF:%.2f",    pf),     pf>=2?C_GRN:(pf>=1?C_ORG:C_RED), 7);
   L("ST_NET", 270, ry, StringFormat("NET:%+.2f",  netPnl), netPnl>=0?C_GRN:C_RED, 7, true);
}

void DrawButtons()
{
   int by  = RH_HDR + RH_ACC + RH_SEP + RH_ZHDR + MODULE_COUNT*RH_ZON + RH_SEP + RH_MKT + RH_STT + RH_SEP;
   int bw  = 90; int bh = 20; int gap = 4; int bry = by + 5;
   string pTxt = g_paused ? "▶ RESUME" : "⏸ PAUSE";
   color  pClr = g_paused ? C_GRN     : (color)0x2980B9;
   MkBtn("BTN_PAUSE", gap,             bry, bw, bh, pTxt,           pClr,              C_WHT);
   MkBtn("BTN_CLOSE", gap+bw+gap,      bry, bw, bh, "✖ CLOSE ALL",  C_RED,             C_WHT);
   MkBtn("BTN_DASH",  gap+2*(bw+gap),  bry, bw, bh, "◉ DASHBOARD",  (color)0x16A085,   C_WHT);
   MkBtn("BTN_CLOUD", gap+3*(bw+gap),  bry, bw, bh, "☁ CLOUDFLARE", C_PRP,             C_GOLD);
}

void UpdatePanel()
{
   if(InpPanel <= 0) return;
   if(TimeCurrent() == g_lastPanelUpdate) return;
   g_lastPanelUpdate = TimeCurrent();
   RefreshBaskets();
   DrawPanelBg();
   DrawHeader();
   DrawAccount();
   DrawZoneTable();
   DrawMarketRow();
   DrawStatsRow();
   DrawButtons();
   DrawBasketLines();
   ChartRedraw(0);
}

void DrawBasketLines()
{
   for(int i=0; i<MODULE_COUNT; i++)
   {
      string base = "ZGM_LINE_" + g_modules[i].cfg.tag;
      StringReplace(base,"/","_");
      string avgNm = base+"_AVG";
      string tpNm  = base+"_TP";
      BasketState b = g_modules[i].basket;
      if(!b.active)
      {
         if(ObjectFind(0,avgNm)>=0) ObjectDelete(0,avgNm);
         if(ObjectFind(0,tpNm) >=0) ObjectDelete(0,tpNm);
         continue;
      }
      double buf  = TargetBufferPoints(g_modules[i].cfg, g_regime);
      double tpPr = b.weightedAvgPrice + (b.direction==DIR_BUY ? buf : -buf)*g_point;

      if(ObjectFind(0,avgNm)<0) ObjectCreate(0,avgNm,OBJ_HLINE,0,0,b.weightedAvgPrice);
      ObjectSetDouble(0, avgNm,OBJPROP_PRICE, b.weightedAvgPrice);
      ObjectSetInteger(0,avgNm,OBJPROP_COLOR, C_ORG);
      ObjectSetInteger(0,avgNm,OBJPROP_STYLE, STYLE_DASH);
      ObjectSetInteger(0,avgNm,OBJPROP_WIDTH, 1);
      ObjectSetInteger(0,avgNm,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,avgNm,OBJPROP_HIDDEN,true);

      if(ObjectFind(0,tpNm)<0) ObjectCreate(0,tpNm,OBJ_HLINE,0,0,tpPr);
      ObjectSetDouble(0, tpNm, OBJPROP_PRICE, tpPr);
      ObjectSetInteger(0,tpNm, OBJPROP_COLOR, C_GRN);
      ObjectSetInteger(0,tpNm, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0,tpNm, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0,tpNm, OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,tpNm, OBJPROP_HIDDEN,true);
   }
}

